{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Landu local environments v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "environments": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "group", "startUrl", "createdAt", "revision", "pendingDeletion", "networkMode"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "\\S" },
          "group": { "type": "string", "maxLength": 40 },
          "startUrl": { "type": "string", "maxLength": 2048, "pattern": "^(about:blank|https://[^\\s]+)$" },
          "createdAt": { "type": "integer", "minimum": 1 },
          "revision": { "type": "integer", "minimum": 1 },
          "pendingDeletion": { "type": "boolean" },
          "networkMode": { "const": "system" }
        }
      }
    }
  }
}
